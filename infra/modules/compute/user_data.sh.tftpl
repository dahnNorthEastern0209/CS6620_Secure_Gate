#!/bin/bash
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

# API key comes from Parameter Store at boot; it never appears in code or Terraform
API_KEY=$(aws ssm get-parameter --region ${region} --name ${api_key_parameter} \
  --with-decryption --query Parameter.Value --output text)

aws ecr get-login-password --region ${region} | \
  docker login --username AWS --password-stdin ${registry}

docker pull ${image}
docker run -d --name scanner -p ${port}:${port} \
  -e SCANNER_API_KEY="$API_KEY" \
  --restart unless-stopped ${image}
